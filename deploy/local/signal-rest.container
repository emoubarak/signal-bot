# signal-cli-rest-api : le compte Signal du bot. Quadlet : systemd --user génère signal-rest.service.
# Installé dans ~/.config/containers/systemd/ (voir deploy/local/README.md).
[Unit]
Description=signal-cli-rest-api (compte Signal du bot)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=signal-rest
# Build CI officielle du 2026-10-22 (signal-cli 0.14.9) : la 0.101 n'a pas encore le mode `manual` ci-dessous.
# Revenir à une version publiée (0.102 ou plus) dès qu'elle sort.
Image=docker.io/bbernhard/signal-cli-rest-api:1792710189-ci
Environment=MODE=json-rpc
# `manual` : signal-cli ne va chercher les messages chez Signal que pendant que le bot écoute. Bot arrêté
# (déploiement, redémarrage), ils attendent sur les serveurs de Signal et arrivent quand il revient. En mode par
# défaut (`on-start`), un message reçu sans le bot connecté est acquitté puis jeté.
Environment=JSON_RPC_RECEIVE_MODE=manual
# Le port n'est publié que sur la boucle locale : lier un appareil se fait depuis la page d'administration du bot.
PublishPort=127.0.0.1:8086:8080
# Les données du compte lié (clés Signal) : à sauvegarder, à ne jamais perdre.
Volume=signal-data:/home/.local/share/signal-cli
# Réseau pasta (Podman sans root) : la route et le DNS de la machine sont copiés au démarrage du conteneur. Quand
# le Wi-Fi change de réseau, le conteneur reste sans route ni DNS : les textes passent encore par une connexion
# déjà ouverte, mais chaque image, GIF ou mème échoue (« UnknownHostException: cdn3.signal.org », 2026-11-07).
# Le contrôle de santé vérifie donc aussi le DNS ; trois échecs d'affilée tuent le conteneur, que systemd relance
# avec le réseau du moment.
HealthCmd=sh -c 'curl -fsS http://localhost:8080/v1/health >/dev/null && getent hosts chat.signal.org >/dev/null'
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
