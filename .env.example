# Signal (signal-cli-rest-api >= 0.101 in json-rpc mode)
SIGNAL_SERVICE=127.0.0.1:8080
PHONE_NUMBER=+33700000000
# The bot answers when called by this name (or an alias), mentioned, replied to, or in private
BOT_NAME=Jarvis
# BOT_ALIASES=Jarv,le bot

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx
# Chat model (any OpenRouter slug with text output; /modele <slug> changes it at runtime)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Image generation and editing (OpenRouter Image API)
IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
# Voice note transcription (needs an audio-input model)
TRANSCRIBE_MODEL=google/gemini-3.1-flash-lite

# Access control (comma-separated, empty = everyone)
# ALLOWED_GROUPS=Famille,group.abc123=
# ALLOWED_NUMBERS=+33600000000
# Who may run /modele <slug> (empty = anyone)
# ADMIN_NUMBERS=+33600000000

# Limits
RATE_LIMIT_PER_HOUR=20
IMAGES_PER_DAY=10
MAX_CONTEXT_MESSAGES=50
MAX_INPUT_CHARS=24000
MAX_OUTPUT_TOKENS=1000

# Misc
TIMEZONE=Europe/Paris
DATA_DIR=data
# Describe every incoming image with the chat model (one vision call per image)
DESCRIBE_IMAGES=false
ATTACHMENT_RETENTION_DAYS=30
