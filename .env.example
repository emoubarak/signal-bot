# Signal (signal-cli-rest-api >= 0.101 in json-rpc mode)
SIGNAL_SERVICE=127.0.0.1:8080
PHONE_NUMBER=+33700000000
# The bot answers when called by this name (or an alias), mentioned, replied to, or in private
BOT_NAME=Jarvis
# BOT_ALIASES=Jarv,the bot

# OpenRouter (https://openrouter.ai/keys)
# Only needed for chat without LOCAL_BASE_URL, and for images and voice notes,
# which a local text server cannot do.
OPENROUTER_API_KEY=sk-or-v1-xxxx

# ── Local model (optional) ───────────────────────────────────────────────────
# Any OpenAI-compatible server (llama-swap, llama-server, vLLM, Ollama…), e.g.
# http://100.111.115.112:8089/v1. When set, chat goes there and needs no key;
# images and voice notes then need OPENROUTER_API_KEY, or must be switched off.
# LOCAL_BASE_URL=http://127.0.0.1:8089/v1

# Chat model. With LOCAL_BASE_URL, the name is the one the local server serves
# (a llama-swap selector works: it loads the model on demand).
CHAT_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash  # older name for CHAT_MODEL, still read

# Image generation and editing (OpenRouter Image API). Empty = off: the bot
# stops offering image generation and says so when asked.
IMAGE_MODEL=meta/muse-image
# IMAGE_MODEL=
# Voice note transcription (needs an audio-input model). Empty = off: voice notes
# are stored as "[voice note not transcribed]".
TRANSCRIBE_MODEL=google/gemini-3.1-flash-lite
# TRANSCRIBE_MODEL=

# Access control (comma-separated, empty = everyone)
# ALLOWED_GROUPS=Family,group.abc123=
# ALLOWED_NUMBERS=+33600000000

# The owner: gets a private message saying which model the bot restarted on
# OWNER_NUMBER=+33600000000
# Announce every restart in the allowed groups and to the owner (default on)
# ANNOUNCE_STARTUP=true

# Limits
RATE_LIMIT_PER_HOUR=20
IMAGES_PER_DAY=10
# Recent messages given to the model with every request
CONTEXT_MESSAGES=30
MAX_OUTPUT_TOKENS=1000

# Misc
TIMEZONE=Europe/Paris
DATA_DIR=data
# Describe every incoming image with the chat model (one vision call per image)
DESCRIBE_IMAGES=false
ATTACHMENT_RETENTION_DAYS=30
# Uptime Kuma push monitor URL, pinged every minute while signal-cli answers
# KUMA_PUSH_URL=http://127.0.0.1:3001/api/push/xxxx
